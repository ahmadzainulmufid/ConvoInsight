rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Semua data aplikasi berada di bawah users/{uid}; hanya pemiliknya yang boleh akses.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Query collectionGroup("items") di halaman Home (filter ownerUid)
    match /{path=**}/items/{itemId} {
      allow read: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
  }
}
